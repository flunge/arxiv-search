\NeedsTeXFormat{LaTeX2e}
\RequirePackage{amsmath}
\RequirePackage{ifthen}
\RequirePackage{xspace}

% abbreviations
\providecommand*{\onedot}{\futurelet\@let@token\@onedot}
\providecommand*{\@onedot}{\ifx\@let@token.\else.\null\fi\xspace}

\providecommand*{\eg}{\emph{e.\thinspace{}g}\onedot}
\providecommand*{\Eg}{\emph{E.\thinspace{}g}\onedot}
\providecommand*{\cf}{\emph{cf}\onedot}
\providecommand*{\vs}{\emph{vs}\onedot}
\providecommand*{\ie}{\emph{i.\thinspace{}e}\onedot}
\providecommand*{\Ie}{\emph{I.\thinspace{}e}\onedot}
\providecommand*{\iid}{\emph{i.\thinspace{}i.\thinspace{}d}\onedot}
\providecommand*{\etc}{\emph{etc}\onedot}
\providecommand*{\wrt}{\emph{w.\thinspace{}r.\thinspace{}t}\onedot}
\providecommand*{\etal}{\emph{et~al}\onedot}
\providecommand*{\lt}{\ensuremath{<}}
\providecommand*{\gt}{\ensuremath{>}}

% Toggle comments on/off
\newif\ifdrafting
\draftingtrue % To show comments
% \draftingfalse % To hide comments

% For rebuttal
\newcommand{\rebuttal}[1]{{\color{blue}{#1}}}
\newcommand{\revfig}[1]{{
    \setlength{\fboxsep}{3pt}
    \setlength{\fboxrule}{2pt}
        \fcolorbox{blue}{white}{#1}
}}


\ifdrafting
% Print comments and line numbers
    \newcommand{\ds}[1]{{\color{red}[DS: #1]}}
    \newcommand{\cih}[1]{{\leavevmode\color[rgb]{0.2,0.6,0.2}[CH: #1]}}
    \newcommand{\jh}[1]{{\leavevmode\color[rgb]{0.8,0,0.8}[JH: #1]}}
    \newcommand{\tz}[1]{{\leavevmode\color[rgb]{0.13,0.55,0.13}[TZ: #1]}}
    \newcommand{\ph}[1]{\textcolor{orange}{\textbf{PH: #1}}}
    \newcommand{\todo}[1]{{\color{orange}{(#1)}}}
\else
    \newcommand{\ds}[1]{}
    \newcommand{\cih}[1]{}
    \newcommand{\jh}[1]{}
    \newcommand{\tz}[1]{}
    \newcommand{\ph}[1]{}    
    \newcommand{\todo}[1]{}
\fi

